 "segments": [
  {
   "i": 0,
   "text": "¿Qué son las auroras boreales?",
   "start": 0.0,
   "end": 1.771
  },
  {
   "i": 1,
   "text": "El Sol lanza sin parar partículas con carga eléctrica: el viento solar.",
   "start": 2.021,
   "end": 6.01
  },
  {
   "i": 2,
   "text": "El campo magnético de la Tierra desvía casi todas.",
   "start": 6.26,
   "end": 9.268
  },
  {
   "i": 3,
   "text": "Pero cerca de los polos, algunas se cuelan hacia la atmósfera.",
   "start": 9.518,
   "end": 12.867
  },
  {
   "i": 4,
   "text": "Allí chocan con gases como el oxígeno y el nitrógeno.",
   "start": 13.117,
   "end": 16.04
  },
  {
   "i": 5,
   "text": "Los choques excitan esos gases, que liberan la energía como luz.",
   "start": 16.29,
   "end": 19.917
  },
  {
   "i": 6,
   "text": "El oxígeno brilla sobre todo en verde; el nitrógeno, en azul o violeta.",
   "start": 20.167,
   "end": 24.135
  },
  {
   "i": 7,
   "text": "Sígueme para más curiosidades de la ciencia.",
   "start": 24.385,
   "end": 26.731
  }
 ],
