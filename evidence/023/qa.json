 "segments": [
  {
   "i": 0,
   "text": "¿Por qué el cinturón se traba si tiras rápido?",
   "start": 0.0,
   "end": 2.496
  },
  {
   "i": 1,
   "text": "La cinta se enrolla en un carrete con un muelle.",
   "start": 2.746,
   "end": 5.242
  },
  {
   "i": 2,
   "text": "Si tiras despacio, el carrete gira y la cinta sale.",
   "start": 5.492,
   "end": 8.521
  },
  {
   "i": 3,
   "text": "Junto al carrete hay una rueda dentada y un trinquete.",
   "start": 8.771,
   "end": 11.779
  },
  {
   "i": 4,
   "text": "En un frenazo, un péndulo sigue hacia delante por inercia.",
   "start": 12.029,
   "end": 15.272
  },
  {
   "i": 5,
   "text": "Ese péndulo empuja el trinquete contra los dientes.",
   "start": 15.522,
   "end": 18.423
  },
  {
   "i": 6,
   "text": "Un tirón brusco también activa el bloqueo del carrete.",
   "start": 18.673,
   "end": 21.553
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 21.803,
   "end": 24.47
  }
 ],
