 "segments": [
  {
   "i": 0,
   "text": "¿Cómo carga el móvil sin cables?",
   "start": 0.0,
   "end": 1.92
  },
  {
   "i": 1,
   "text": "Dentro de la base hay una bobina de cable de cobre.",
   "start": 2.17,
   "end": 4.858
  },
  {
   "i": 2,
   "text": "Por ella pasa una corriente que cambia de sentido muy rápido.",
   "start": 5.108,
   "end": 8.436
  },
  {
   "i": 3,
   "text": "Esa corriente crea un campo magnético que también cambia sin parar.",
   "start": 8.686,
   "end": 12.526
  },
  {
   "i": 4,
   "text": "El móvil tiene otra bobina justo encima de la base.",
   "start": 12.776,
   "end": 15.635
  },
  {
   "i": 5,
   "text": "El campo variable atraviesa esa bobina e induce una corriente.",
   "start": 15.885,
   "end": 19.554
  },
  {
   "i": 6,
   "text": "Esa corriente, ya convertida, va cargando la batería.",
   "start": 19.804,
   "end": 22.94
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 23.19,
   "end": 25.857
  }
 ],
