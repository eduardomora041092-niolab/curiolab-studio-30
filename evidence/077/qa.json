 "segments": [
  {
   "i": 0,
   "text": "¿Por qué un ascensor necesita un contrapeso?",
   "start": 0.0,
   "end": 2.432
  },
  {
   "i": 1,
   "text": "La cabina cuelga de cables de acero que pasan por una polea arriba.",
   "start": 2.682,
   "end": 6.394
  },
  {
   "i": 2,
   "text": "Al otro lado de los cables cuelga un bloque pesado: el contrapeso.",
   "start": 6.644,
   "end": 10.079
  },
  {
   "i": 3,
   "text": "Pesa como la cabina más una parte de la carga habitual.",
   "start": 10.329,
   "end": 13.593
  },
  {
   "i": 4,
   "text": "Así, cuando la cabina sube, el contrapeso baja, y los dos se equilibran.",
   "start": 13.843,
   "end": 17.597
  },
  {
   "i": 5,
   "text": "El motor solo tiene que mover la diferencia de peso, no todo.",
   "start": 17.847,
   "end": 21.325
  },
  {
   "i": 6,
   "text": "Por eso gasta mucha menos energía y el motor puede ser más pequeño.",
   "start": 21.575,
   "end": 25.479
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 25.729,
   "end": 28.395
  }
 ],
