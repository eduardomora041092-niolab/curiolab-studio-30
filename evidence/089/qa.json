 "segments": [
  {
   "i": 0,
   "text": "¿Cómo puede una sola llave agarrar tuercas de muchos tamaños?",
   "start": 0.0,
   "end": 3.221
  },
  {
   "i": 1,
   "text": "Tiene una mandíbula fija y otra que se desliza.",
   "start": 3.471,
   "end": 6.202
  },
  {
   "i": 2,
   "text": "Bajo la mandíbula móvil hay una fila de dientes.",
   "start": 6.452,
   "end": 9.033
  },
  {
   "i": 3,
   "text": "Esos dientes encajan en un tornillo sin fin: una ruedita con rosca.",
   "start": 9.283,
   "end": 13.315
  },
  {
   "i": 4,
   "text": "Al girarlo con el pulgar, su rosca empuja los dientes.",
   "start": 13.565,
   "end": 16.531
  },
  {
   "i": 5,
   "text": "La mandíbula se mueve y la abertura se agranda o se achica.",
   "start": 16.781,
   "end": 20.002
  },
  {
   "i": 6,
   "text": "Así encaja justo en la tuerca, y la rosca impide que se abra sola.",
   "start": 20.252,
   "end": 23.985
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 24.235,
   "end": 26.902
  }
 ],
