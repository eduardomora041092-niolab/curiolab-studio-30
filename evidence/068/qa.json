 "segments": [
  {
   "i": 0,
   "text": "¿Cómo corta el metal un abrelatas sin esfuerzo?",
   "start": 0.0,
   "end": 2.539
  },
  {
   "i": 1,
   "text": "Tiene dos ruedas: una cuchilla circular y una rueda dentada.",
   "start": 2.789,
   "end": 6.33
  },
  {
   "i": 2,
   "text": "Al cerrar los mangos, actúan como palanca y aprietan la cuchilla contra la tapa.",
   "start": 6.58,
   "end": 11.081
  },
  {
   "i": 3,
   "text": "La cuchilla, muy afilada, perfora el metal fino de la tapa.",
   "start": 11.331,
   "end": 14.659
  },
  {
   "i": 4,
   "text": "La rueda dentada muerde el borde de la lata por el costado.",
   "start": 14.909,
   "end": 18.067
  },
  {
   "i": 5,
   "text": "Al girar la llave, esa rueda arrastra el borde y hace girar la lata.",
   "start": 18.317,
   "end": 21.986
  },
  {
   "i": 6,
   "text": "La cuchilla rueda por todo el borde y corta un círculo completo.",
   "start": 22.236,
   "end": 25.927
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 26.177,
   "end": 28.843
  }
 ],
