 "segments": [
  {
   "i": 0,
   "text": "¿Qué hace que un volcán entre en erupción?",
   "start": 0.0,
   "end": 2.261
  },
  {
   "i": 1,
   "text": "Bajo el volcán hay una cámara con magma: roca fundida.",
   "start": 2.511,
   "end": 5.69
  },
  {
   "i": 2,
   "text": "El magma es menos denso que la roca y tiende a subir.",
   "start": 5.94,
   "end": 9.033
  },
  {
   "i": 3,
   "text": "Lleva gases disueltos, como vapor de agua, a mucha presión.",
   "start": 9.283,
   "end": 12.633
  },
  {
   "i": 4,
   "text": "Al subir, la presión baja y los gases forman burbujas.",
   "start": 12.883,
   "end": 16.019
  },
  {
   "i": 5,
   "text": "Las burbujas crecen y empujan el magma hacia arriba.",
   "start": 16.269,
   "end": 19.277
  },
  {
   "i": 6,
   "text": "Si la roca de encima cede, el magma sale: es la erupción.",
   "start": 19.527,
   "end": 22.62
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 22.87,
   "end": 25.537
  }
 ],
