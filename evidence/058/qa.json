 "segments": [
  {
   "i": 0,
   "text": "¿De dónde salen los escalones de una escalera mecánica?",
   "start": 0.0,
   "end": 3.008
  },
  {
   "i": 1,
   "text": "Todos los escalones van unidos a una cadena que forma un bucle.",
   "start": 3.258,
   "end": 6.842
  },
  {
   "i": 2,
   "text": "Un motor arriba hace girar la cadena sin parar.",
   "start": 7.092,
   "end": 9.801
  },
  {
   "i": 3,
   "text": "Cada escalón tiene ruedas que van por dos carriles distintos.",
   "start": 10.051,
   "end": 13.422
  },
  {
   "i": 4,
   "text": "En la cuesta, los carriles se separan y forman los peldaños.",
   "start": 13.672,
   "end": 17.0
  },
  {
   "i": 5,
   "text": "Arriba, los carriles se juntan y los escalones quedan planos.",
   "start": 17.25,
   "end": 20.599
  },
  {
   "i": 6,
   "text": "Luego dan la vuelta por debajo y regresan al principio.",
   "start": 20.849,
   "end": 24.007
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 24.257,
   "end": 26.923
  }
 ],
