 "segments": [
  {
   "i": 0,
   "text": "¿Cómo corta un cortaúñas con tan poco esfuerzo?",
   "start": 0.0,
   "end": 2.581
  },
  {
   "i": 1,
   "text": "Por dentro tiene dos palancas, una encima de la otra.",
   "start": 2.831,
   "end": 5.626
  },
  {
   "i": 2,
   "text": "La de arriba es el mango y gira sobre el perno.",
   "start": 5.876,
   "end": 8.479
  },
  {
   "i": 3,
   "text": "Al apretar su extremo largo, empuja las hojas con más fuerza.",
   "start": 8.729,
   "end": 12.185
  },
  {
   "i": 4,
   "text": "Las hojas son la segunda palanca, unidas por detrás.",
   "start": 12.435,
   "end": 15.379
  },
  {
   "i": 5,
   "text": "Al bajar, sus filos se juntan y cortan la uña.",
   "start": 15.629,
   "end": 18.189
  },
  {
   "i": 6,
   "text": "Juntas, multiplican varias veces la fuerza de tu dedo.",
   "start": 18.439,
   "end": 21.724
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 21.974,
   "end": 24.641
  }
 ],
