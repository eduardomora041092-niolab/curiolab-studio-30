 "segments": [
  {
   "i": 0,
   "text": "¿Cómo se abre un candado con solo tres números?",
   "start": 0.0,
   "end": 2.603
  },
  {
   "i": 1,
   "text": "Dentro del candado hay tres discos apilados, uno por número.",
   "start": 2.853,
   "end": 6.309
  },
  {
   "i": 2,
   "text": "Cada disco tiene una pequeña muesca en el borde.",
   "start": 6.559,
   "end": 9.311
  },
  {
   "i": 3,
   "text": "Al girar la rueda, los discos cambian de posición.",
   "start": 9.561,
   "end": 12.398
  },
  {
   "i": 4,
   "text": "Con el número correcto, cada muesca queda en su sitio.",
   "start": 12.648,
   "end": 15.528
  },
  {
   "i": 5,
   "text": "Si un solo disco está mal, la barra no puede bajar.",
   "start": 15.778,
   "end": 18.594
  },
  {
   "i": 6,
   "text": "Con las tres alineadas, la barra cae en las muescas y suelta el arco.",
   "start": 18.844,
   "end": 22.663
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 22.913,
   "end": 25.579
  }
 ],
