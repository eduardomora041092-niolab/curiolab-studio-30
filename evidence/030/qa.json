 "segments": [
  {
   "i": 0,
   "text": "¿Por qué tu refresco burbujea al abrirlo?",
   "start": 0.0,
   "end": 2.368
  },
  {
   "i": 1,
   "text": "En la fábrica le meten dióxido de carbono a presión.",
   "start": 2.618,
   "end": 5.647
  },
  {
   "i": 2,
   "text": "Con la botella cerrada, ese gas queda disuelto en el líquido.",
   "start": 5.897,
   "end": 9.14
  },
  {
   "i": 3,
   "text": "La presión lo mantiene escondido: por eso no ves burbujas.",
   "start": 9.39,
   "end": 12.675
  },
  {
   "i": 4,
   "text": "Al abrirla, la presión baja de golpe con un siseo.",
   "start": 12.925,
   "end": 15.827
  },
  {
   "i": 5,
   "text": "El gas ya no cabe disuelto en el líquido y empieza a escapar.",
   "start": 16.077,
   "end": 19.426
  },
  {
   "i": 6,
   "text": "Forma burbujas en pequeñas imperfecciones del envase y suben.",
   "start": 19.676,
   "end": 23.303
  },
  {
   "i": 7,
   "text": "Sígueme para más curiosidades de la ciencia.",
   "start": 23.553,
   "end": 25.899
  }
 ],
