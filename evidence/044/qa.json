 "segments": [
  {
   "i": 0,
   "text": "¿Cómo apaga el fuego un extintor?",
   "start": 0.0,
   "end": 1.877
  },
  {
   "i": 1,
   "text": "El fuego necesita tres cosas: calor, combustible y oxígeno.",
   "start": 2.127,
   "end": 5.583
  },
  {
   "i": 2,
   "text": "Dentro del extintor, un gas mantiene el agente a presión.",
   "start": 5.833,
   "end": 8.905
  },
  {
   "i": 3,
   "text": "Al apretar la palanca de arriba, se abre una válvula.",
   "start": 9.155,
   "end": 11.929
  },
  {
   "i": 4,
   "text": "La presión empuja el agente por un tubo hasta la manguera.",
   "start": 12.179,
   "end": 15.379
  },
  {
   "i": 5,
   "text": "El chorro se dirige a la base de las llamas, no a la punta.",
   "start": 15.629,
   "end": 18.615
  },
  {
   "i": 6,
   "text": "El agente enfría el fuego o lo tapa sin oxígeno, y se apaga.",
   "start": 18.865,
   "end": 22.215
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 22.465,
   "end": 25.131
  }
 ],
