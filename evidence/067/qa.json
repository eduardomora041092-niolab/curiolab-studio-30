 "segments": [
  {
   "i": 0,
   "text": "¿Cómo lee un escáner el código de barras?",
   "start": 0.0,
   "end": 2.112
  },
  {
   "i": 1,
   "text": "Las barras negras y los espacios blancos guardan un número.",
   "start": 2.362,
   "end": 5.669
  },
  {
   "i": 2,
   "text": "El escáner ilumina el código con un láser o una luz roja.",
   "start": 5.919,
   "end": 9.204
  },
  {
   "i": 3,
   "text": "Los espacios blancos reflejan mucha luz y las barras negras casi nada.",
   "start": 9.454,
   "end": 13.635
  },
  {
   "i": 4,
   "text": "Un sensor recibe esos reflejos y los convierte en una señal eléctrica.",
   "start": 13.885,
   "end": 17.875
  },
  {
   "i": 5,
   "text": "Según el ancho de cada barra, ese patrón se traduce en dígitos.",
   "start": 18.125,
   "end": 21.73
  },
  {
   "i": 6,
   "text": "El ordenador busca ese número y muestra el producto y su precio.",
   "start": 21.98,
   "end": 25.564
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 25.814,
   "end": 28.481
  }
 ],
