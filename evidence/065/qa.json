 "segments": [
  {
   "i": 0,
   "text": "¿Cómo sabe el GPS dónde estás?",
   "start": 0.0,
   "end": 2.005
  },
  {
   "i": 1,
   "text": "Varios satélites envían señales con la hora exacta de salida.",
   "start": 2.255,
   "end": 5.903
  },
  {
   "i": 2,
   "text": "Tu móvil solo escucha: no envía nada a los satélites.",
   "start": 6.153,
   "end": 9.247
  },
  {
   "i": 3,
   "text": "Mide cuánto tardó cada señal en llegar y calcula la distancia.",
   "start": 9.497,
   "end": 12.995
  },
  {
   "i": 4,
   "text": "Cada distancia dibuja una esfera alrededor de un satélite.",
   "start": 13.245,
   "end": 16.723
  },
  {
   "i": 5,
   "text": "Con varios satélites, las esferas se cruzan en un solo punto.",
   "start": 16.973,
   "end": 20.578
  },
  {
   "i": 6,
   "text": "Ese punto es tu posición; un cuarto satélite corrige el reloj.",
   "start": 20.828,
   "end": 24.583
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 24.833,
   "end": 27.499
  }
 ],
