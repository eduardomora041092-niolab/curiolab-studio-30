 "segments": [
  {
   "i": 0,
   "text": "¿Cómo se recarga la batería de tu móvil?",
   "start": 0.0,
   "end": 2.24
  },
  {
   "i": 1,
   "text": "Dentro hay dos electrodos separados por un líquido llamado electrolito.",
   "start": 2.49,
   "end": 6.373
  },
  {
   "i": 2,
   "text": "Al cargar, el cargador empuja electrones por el cable hacia un electrodo.",
   "start": 6.623,
   "end": 10.463
  },
  {
   "i": 3,
   "text": "Los iones de litio cruzan el electrolito y se guardan en ese lado.",
   "start": 10.713,
   "end": 14.446
  },
  {
   "i": 4,
   "text": "Así la batería queda cargada de energía.",
   "start": 14.696,
   "end": 17.064
  },
  {
   "i": 5,
   "text": "Al usar el móvil, los iones vuelven al otro electrodo.",
   "start": 17.314,
   "end": 20.279
  },
  {
   "i": 6,
   "text": "Y los electrones regresan por el circuito, dando energía al móvil.",
   "start": 20.529,
   "end": 24.135
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 24.385,
   "end": 27.051
  }
 ],
