 "segments": [
  {
   "i": 0,
   "text": "¿Por qué un barco de acero flota y una bola se hunde?",
   "start": 0.0,
   "end": 2.731
  },
  {
   "i": 1,
   "text": "Todo objeto en el agua aparta un poco de agua.",
   "start": 2.981,
   "end": 5.583
  },
  {
   "i": 2,
   "text": "El agua lo empuja hacia arriba con el peso del agua apartada.",
   "start": 5.833,
   "end": 9.183
  },
  {
   "i": 3,
   "text": "Una bola maciza de acero aparta poca agua: su empuje es pequeño.",
   "start": 9.433,
   "end": 13.123
  },
  {
   "i": 4,
   "text": "Pesa más que ese empuje, y se hunde.",
   "start": 13.373,
   "end": 15.4
  },
  {
   "i": 5,
   "text": "Con ese mismo acero, un casco hueco aparta muchísima agua.",
   "start": 15.65,
   "end": 19.17
  },
  {
   "i": 6,
   "text": "Baja hasta que el agua apartada pesa lo mismo que él, y flota.",
   "start": 19.42,
   "end": 22.727
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir más ciencia.",
   "start": 22.977,
   "end": 24.939
  }
 ],
