 "segments": [
  {
   "i": 0,
   "text": "¿Cómo derrite la sal el hielo si no lo calienta?",
   "start": 0.0,
   "end": 2.517
  },
  {
   "i": 1,
   "text": "Sobre el hielo siempre hay una capa finísima de agua líquida.",
   "start": 2.767,
   "end": 5.946
  },
  {
   "i": 2,
   "text": "Ahí, unas moléculas se congelan y otras se funden a la vez.",
   "start": 6.196,
   "end": 9.417
  },
  {
   "i": 3,
   "text": "La sal se disuelve en esa agua y forma salmuera.",
   "start": 9.667,
   "end": 12.462
  },
  {
   "i": 4,
   "text": "Sus partículas estorban a las moléculas que intentan congelarse.",
   "start": 12.712,
   "end": 16.488
  },
  {
   "i": 5,
   "text": "Se funde más agua de la que se congela, y el hielo mengua.",
   "start": 16.738,
   "end": 19.767
  },
  {
   "i": 6,
   "text": "Por eso el agua salada se congela por debajo de cero grados.",
   "start": 20.017,
   "end": 23.537
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 23.787,
   "end": 26.454
  }
 ],
