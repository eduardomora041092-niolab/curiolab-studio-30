 "segments": [
  {
   "i": 0,
   "text": "¿Por qué las hojas cambian de color en otoño?",
   "start": 0.0,
   "end": 2.411
  },
  {
   "i": 1,
   "text": "En verano, las hojas están llenas de clorofila, un pigmento verde.",
   "start": 2.661,
   "end": 6.479
  },
  {
   "i": 2,
   "text": "La clorofila capta la luz del sol para fabricar alimento.",
   "start": 6.729,
   "end": 10.121
  },
  {
   "i": 3,
   "text": "Pero la hoja también tiene pigmentos amarillos y naranjas, tapados por el verde.",
   "start": 10.371,
   "end": 14.638
  },
  {
   "i": 4,
   "text": "En otoño los días se acortan y el árbol deja de fabricar clorofila.",
   "start": 14.888,
   "end": 18.835
  },
  {
   "i": 5,
   "text": "El verde se descompone y aparecen los amarillos que siempre estuvieron ahí.",
   "start": 19.085,
   "end": 23.159
  },
  {
   "i": 6,
   "text": "Los rojos, en cambio, se fabrican nuevos en algunas hojas.",
   "start": 23.409,
   "end": 26.759
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 27.009,
   "end": 29.675
  }
 ],
