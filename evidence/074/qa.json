 "segments": [
  {
   "i": 0,
   "text": "¿Cómo crean silencio unos auriculares con más sonido?",
   "start": 0.0,
   "end": 3.029
  },
  {
   "i": 1,
   "text": "El ruido llega al oído como una onda de presión.",
   "start": 3.279,
   "end": 6.095
  },
  {
   "i": 2,
   "text": "Un micrófono en el auricular escucha ese ruido sin parar.",
   "start": 6.345,
   "end": 9.652
  },
  {
   "i": 3,
   "text": "Un chip calcula una onda igual, pero invertida.",
   "start": 9.902,
   "end": 12.59
  },
  {
   "i": 4,
   "text": "El altavoz la reproduce: donde el ruido sube, ella baja.",
   "start": 12.84,
   "end": 16.04
  },
  {
   "i": 5,
   "text": "Al sumarse, las dos ondas se anulan y el ruido casi desaparece.",
   "start": 16.29,
   "end": 19.831
  },
  {
   "i": 6,
   "text": "Funciona mejor con zumbidos constantes, como el motor de un avión.",
   "start": 20.081,
   "end": 23.559
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 23.809,
   "end": 26.475
  }
 ],
