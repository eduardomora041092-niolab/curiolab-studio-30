 "segments": [
  {
   "i": 0,
   "text": "¿Cómo funciona el picaporte de una puerta?",
   "start": 0.0,
   "end": 2.261
  },
  {
   "i": 1,
   "text": "Dentro de la puerta hay un pestillo con la punta inclinada.",
   "start": 2.511,
   "end": 5.711
  },
  {
   "i": 2,
   "text": "Un muelle empuja el pestillo hacia fuera, hacia el marco.",
   "start": 5.961,
   "end": 8.991
  },
  {
   "i": 3,
   "text": "Al girar la manilla, el eje mueve una pieza que tira del pestillo.",
   "start": 9.241,
   "end": 12.782
  },
  {
   "i": 4,
   "text": "El pestillo se esconde y la puerta se puede abrir.",
   "start": 13.032,
   "end": 15.827
  },
  {
   "i": 5,
   "text": "Sueltas la manilla y el muelle lo devuelve a su sitio.",
   "start": 16.077,
   "end": 18.999
  },
  {
   "i": 6,
   "text": "Al cerrar, su cara inclinada roza el marco, entra y luego encaja en el hueco.",
   "start": 19.249,
   "end": 23.516
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 23.766,
   "end": 26.433
  }
 ],
