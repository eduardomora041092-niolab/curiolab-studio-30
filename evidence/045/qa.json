 "segments": [
  {
   "i": 0,
   "text": "¿Cómo cambia de color un camaleón?",
   "start": 0.0,
   "end": 1.984
  },
  {
   "i": 1,
   "text": "Su piel tiene una capa con diminutos cristales ordenados.",
   "start": 2.234,
   "end": 5.541
  },
  {
   "i": 2,
   "text": "Esos cristales reflejan la luz de un color concreto.",
   "start": 5.791,
   "end": 8.969
  },
  {
   "i": 3,
   "text": "Relajado, los cristales están juntos y reflejan azul.",
   "start": 9.219,
   "end": 12.569
  },
  {
   "i": 4,
   "text": "Un pigmento amarillo encima hace que se vea verde.",
   "start": 12.819,
   "end": 15.763
  },
  {
   "i": 5,
   "text": "Excitado, los cristales se separan un poco más.",
   "start": 16.013,
   "end": 18.914
  },
  {
   "i": 6,
   "text": "Así reflejan amarillo o naranja, y la piel cambia.",
   "start": 19.164,
   "end": 22.023
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 22.273,
   "end": 24.939
  }
 ],
