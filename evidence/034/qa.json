 "segments": [
  {
   "i": 0,
   "text": "¿Cómo gira un motor eléctrico?",
   "start": 0.0,
   "end": 1.728
  },
  {
   "i": 1,
   "text": "Dentro, una bobina de cable puede girar entre dos imanes.",
   "start": 1.978,
   "end": 5.093
  },
  {
   "i": 2,
   "text": "Al pasar corriente, la bobina se convierte en un electroimán.",
   "start": 5.343,
   "end": 8.649
  },
  {
   "i": 3,
   "text": "Sus polos son atraídos y repelidos por los imanes, y la bobina gira.",
   "start": 8.899,
   "end": 12.633
  },
  {
   "i": 4,
   "text": "Pero al quedar frente a los polos opuestos, se pararía.",
   "start": 12.883,
   "end": 15.72
  },
  {
   "i": 5,
   "text": "Justo ahí, el conmutador invierte el sentido de la corriente.",
   "start": 15.97,
   "end": 19.213
  },
  {
   "i": 6,
   "text": "Los polos de la bobina se intercambian y sigue girando sin parar.",
   "start": 19.463,
   "end": 22.961
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 23.211,
   "end": 25.878
  }
 ],
