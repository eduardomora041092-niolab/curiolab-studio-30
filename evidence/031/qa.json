 "segments": [
  {
   "i": 0,
   "text": "¿Cómo convierte un altavoz electricidad en sonido?",
   "start": 0.0,
   "end": 2.816
  },
  {
   "i": 1,
   "text": "Detrás del cono hay una bobina de cable, justo al lado de un imán.",
   "start": 3.066,
   "end": 6.437
  },
  {
   "i": 2,
   "text": "Por ella pasa la corriente de la música, que cambia sin parar.",
   "start": 6.687,
   "end": 9.844
  },
  {
   "i": 3,
   "text": "Esa corriente convierte la bobina en un electroimán.",
   "start": 10.094,
   "end": 12.995
  },
  {
   "i": 4,
   "text": "El imán la empuja y la atrae, adelante y atrás, muy rápido.",
   "start": 13.245,
   "end": 16.531
  },
  {
   "i": 5,
   "text": "La bobina arrastra el cono, que vibra al mismo ritmo.",
   "start": 16.781,
   "end": 19.639
  },
  {
   "i": 6,
   "text": "El cono empuja el aire y crea ondas de sonido.",
   "start": 19.889,
   "end": 22.62
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 22.87,
   "end": 25.537
  }
 ],
