 "segments": [
  {
   "i": 0,
   "text": "¿Por qué tu gato cae de pie al saltar?",
   "start": 0.0,
   "end": 2.197
  },
  {
   "i": 1,
   "text": "Su oído interno le indica en todo momento dónde está arriba.",
   "start": 2.447,
   "end": 5.861
  },
  {
   "i": 2,
   "text": "En el aire no tiene ningún sitio en el que apoyarse.",
   "start": 6.111,
   "end": 9.012
  },
  {
   "i": 3,
   "text": "Por eso dobla el cuerpo por la cintura.",
   "start": 9.262,
   "end": 11.651
  },
  {
   "i": 4,
   "text": "Recoge las patas delanteras y gira primero la mitad delantera.",
   "start": 11.901,
   "end": 15.528
  },
  {
   "i": 5,
   "text": "Después recoge las traseras y gira la mitad trasera.",
   "start": 15.778,
   "end": 18.871
  },
  {
   "i": 6,
   "text": "Así suele llegar al suelo con las patas abajo, amortiguando.",
   "start": 19.121,
   "end": 22.492
  },
  {
   "i": 7,
   "text": "Sígueme para más curiosidades de la ciencia.",
   "start": 22.742,
   "end": 25.089
  }
 ],
