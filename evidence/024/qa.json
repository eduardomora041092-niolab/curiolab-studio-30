 "segments": [
  {
   "i": 0,
   "text": "¿Por qué en verano el sol calienta más?",
   "start": 0.0,
   "end": 2.219
  },
  {
   "i": 1,
   "text": "No es porque la Tierra esté más cerca del Sol.",
   "start": 2.469,
   "end": 5.135
  },
  {
   "i": 2,
   "text": "El eje sobre el que gira la Tierra está inclinado.",
   "start": 5.385,
   "end": 8.031
  },
  {
   "i": 3,
   "text": "Durante el año, un hemisferio queda inclinado hacia el Sol.",
   "start": 8.281,
   "end": 11.502
  },
  {
   "i": 4,
   "text": "Allí los rayos llegan más directos y concentran su calor.",
   "start": 11.752,
   "end": 15.08
  },
  {
   "i": 5,
   "text": "Además, allí los días son más largos: es verano.",
   "start": 15.33,
   "end": 17.997
  },
  {
   "i": 6,
   "text": "En el otro hemisferio, la luz llega inclinada y se reparte: invierno.",
   "start": 18.247,
   "end": 22.001
  },
  {
   "i": 7,
   "text": "Sígueme para más curiosidades de la ciencia.",
   "start": 22.251,
   "end": 24.598
  }
 ],
