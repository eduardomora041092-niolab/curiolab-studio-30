 "segments": [
  {
   "i": 0,
   "text": "La grapa entra recta y sale doblada.",
   "start": 0.0,
   "end": 2.197
  },
  {
   "i": 1,
   "text": "Las grapas esperan en fila, empujadas por un muelle.",
   "start": 2.447,
   "end": 5.434
  },
  {
   "i": 2,
   "text": "Al apretar, una cuchilla fina empuja solo la primera grapa.",
   "start": 5.684,
   "end": 8.969
  },
  {
   "i": 3,
   "text": "Sus dos patas atraviesan el papel.",
   "start": 9.219,
   "end": 11.523
  },
  {
   "i": 4,
   "text": "Debajo las espera el yunque, una placa de metal con dos ranuras curvas.",
   "start": 11.773,
   "end": 15.592
  },
  {
   "i": 5,
   "text": "Las ranuras doblan las patas hacia dentro, y la grapa abraza el papel.",
   "start": 15.842,
   "end": 19.746
  },
  {
   "i": 6,
   "text": "En muchas, si giras el yunque, se doblan hacia fuera.",
   "start": 19.996,
   "end": 22.855
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan las cosas.",
   "start": 23.105,
   "end": 25.75
  }
 ],
