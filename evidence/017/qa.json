 "segments": [
  {
   "i": 0,
   "text": "Suéltala y la cinta métrica regresa a toda velocidad.",
   "start": 0.0,
   "end": 3.2
  },
  {
   "i": 1,
   "text": "Dentro de la carcasa, la cinta está enrollada en un carrete.",
   "start": 3.45,
   "end": 6.693
  },
  {
   "i": 2,
   "text": "En el centro del carrete hay un muelle plano en espiral.",
   "start": 6.943,
   "end": 9.844
  },
  {
   "i": 3,
   "text": "Al sacar la cinta, el carrete gira y aprieta el muelle.",
   "start": 10.094,
   "end": 13.123
  },
  {
   "i": 4,
   "text": "El muelle guarda esa energía, como un juguete de cuerda.",
   "start": 13.373,
   "end": 16.381
  },
  {
   "i": 5,
   "text": "Un botón de freno pisa la cinta para que no vuelva.",
   "start": 16.631,
   "end": 19.533
  },
  {
   "i": 6,
   "text": "Al soltar el freno, el muelle se desenrolla y tira de la cinta hacia dentro.",
   "start": 19.783,
   "end": 23.879
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 24.129,
   "end": 26.795
  }
 ],
