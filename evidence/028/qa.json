 "segments": [
  {
   "i": 0,
   "text": "¿Cómo detecta el humo tu detector sin ojos?",
   "start": 0.0,
   "end": 2.432
  },
  {
   "i": 1,
   "text": "Dentro tiene una cámara oscura con una luz y un sensor.",
   "start": 2.682,
   "end": 5.797
  },
  {
   "i": 2,
   "text": "La luz y el sensor no se miran: están en ángulo.",
   "start": 6.047,
   "end": 8.713
  },
  {
   "i": 3,
   "text": "Con aire limpio, la luz sigue recta y nunca llega al sensor.",
   "start": 8.963,
   "end": 12.313
  },
  {
   "i": 4,
   "text": "Cuando entra humo, sus partículas desvían parte de la luz.",
   "start": 12.563,
   "end": 15.827
  },
  {
   "i": 5,
   "text": "Esa luz desviada llega al sensor, que avisa al circuito.",
   "start": 16.077,
   "end": 19.277
  },
  {
   "i": 6,
   "text": "Si la señal supera un límite fijado, suena la alarma.",
   "start": 19.527,
   "end": 22.449
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 22.699,
   "end": 25.366
  }
 ],
