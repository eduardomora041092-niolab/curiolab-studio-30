 "segments": [
  {
   "i": 0,
   "text": "¿Cómo puede caer hielo del cielo en pleno verano?",
   "start": 0.0,
   "end": 2.667
  },
  {
   "i": 1,
   "text": "El granizo nace en nubes de tormenta muy altas.",
   "start": 2.917,
   "end": 5.711
  },
  {
   "i": 2,
   "text": "Arriba hace mucho frío, aunque abajo sea verano.",
   "start": 5.961,
   "end": 8.692
  },
  {
   "i": 3,
   "text": "Allí hay gotitas de agua muy frías que siguen líquidas.",
   "start": 8.942,
   "end": 11.929
  },
  {
   "i": 4,
   "text": "Fuertes corrientes de aire suben pequeñas bolitas de hielo.",
   "start": 12.179,
   "end": 15.4
  },
  {
   "i": 5,
   "text": "Al chocar con esas gotitas, se congelan encima y la bola crece capa a capa.",
   "start": 15.65,
   "end": 20.023
  },
  {
   "i": 6,
   "text": "Cuando pesa demasiado para que el aire la sostenga, cae como granizo.",
   "start": 20.273,
   "end": 24.028
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 24.278,
   "end": 26.945
  }
 ],
