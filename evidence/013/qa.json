 "segments": [
  {
   "i": 0,
   "text": "Nadie la apaga, pero la tostadora salta sola.",
   "start": 0.0,
   "end": 2.688
  },
  {
   "i": 1,
   "text": "Al bajar la palanca, la bandeja tensa un muelle.",
   "start": 2.938,
   "end": 5.647
  },
  {
   "i": 2,
   "text": "Abajo, un electroimán la sujeta y se encienden las resistencias.",
   "start": 5.897,
   "end": 9.545
  },
  {
   "i": 3,
   "text": "Las resistencias se ponen al rojo y tuestan el pan.",
   "start": 9.795,
   "end": 12.782
  },
  {
   "i": 4,
   "text": "Un temporizador cuenta el tiempo que elegiste.",
   "start": 13.032,
   "end": 15.613
  },
  {
   "i": 5,
   "text": "Cuando se acaba, corta la corriente del electroimán y este suelta la bandeja.",
   "start": 15.863,
   "end": 19.981
  },
  {
   "i": 6,
   "text": "El muelle la sube, se apagan las resistencias y la tostada salta.",
   "start": 20.231,
   "end": 23.815
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan las cosas.",
   "start": 24.065,
   "end": 26.71
  }
 ],
