 "segments": [
  {
   "i": 0,
   "text": "¿Cómo se infla un airbag tan rápido?",
   "start": 0.0,
   "end": 2.112
  },
  {
   "i": 1,
   "text": "En un choque, un sensor detecta el frenazo brusco del coche.",
   "start": 2.362,
   "end": 5.733
  },
  {
   "i": 2,
   "text": "Al instante envía una señal eléctrica al generador de gas.",
   "start": 5.983,
   "end": 9.417
  },
  {
   "i": 3,
   "text": "Allí, una reacción química produce muchísimo gas de golpe.",
   "start": 9.667,
   "end": 12.889
  },
  {
   "i": 4,
   "text": "Ese gas llena la bolsa plegada, que sale del volante.",
   "start": 13.139,
   "end": 16.125
  },
  {
   "i": 5,
   "text": "La bolsa recibe tu cuerpo y lo frena con suavidad.",
   "start": 16.375,
   "end": 19.277
  },
  {
   "i": 6,
   "text": "Luego el gas escapa por unos orificios y la bolsa se desinfla.",
   "start": 19.527,
   "end": 23.132
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 23.382,
   "end": 26.049
  }
 ],
