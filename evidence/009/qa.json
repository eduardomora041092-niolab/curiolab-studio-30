 "segments": [
  {
   "i": 0,
   "text": "Cada gota de lluvia funciona como un pequeño prisma.",
   "start": 0.0,
   "end": 2.923
  },
  {
   "i": 1,
   "text": "La luz del Sol parece blanca, pero mezcla todos los colores.",
   "start": 3.173,
   "end": 6.629
  },
  {
   "i": 2,
   "text": "Al entrar en la gota, la luz se dobla, y cada color, un poco distinto.",
   "start": 6.879,
   "end": 10.676
  },
  {
   "i": 3,
   "text": "Se refleja en el fondo y sale con los colores separados.",
   "start": 10.926,
   "end": 14.019
  },
  {
   "i": 4,
   "text": "Por eso, el Sol tiene que estar a tu espalda.",
   "start": 14.269,
   "end": 16.744
  },
  {
   "i": 5,
   "text": "Cada gota te envía un solo color según su posición.",
   "start": 16.994,
   "end": 20.087
  },
  {
   "i": 6,
   "text": "Las gotas al mismo ángulo forman un arco, con el rojo arriba.",
   "start": 20.337,
   "end": 23.708
  },
  {
   "i": 7,
   "text": "Sígueme para más curiosidades de la ciencia.",
   "start": 23.958,
   "end": 26.305
  }
 ]
}