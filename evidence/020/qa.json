 "segments": [
  {
   "i": 0,
   "text": "¿Cómo marca los segundos un reloj sin pilas?",
   "start": 0.0,
   "end": 2.432
  },
  {
   "i": 1,
   "text": "Al darle cuerda, se enrolla un muelle en espiral.",
   "start": 2.682,
   "end": 5.349
  },
  {
   "i": 2,
   "text": "Ese muelle guarda la energía que mueve todo el reloj.",
   "start": 5.599,
   "end": 8.543
  },
  {
   "i": 3,
   "text": "La energía pasa por engranajes hasta la rueda de escape.",
   "start": 8.793,
   "end": 11.865
  },
  {
   "i": 4,
   "text": "Un volante oscila de un lado a otro a ritmo constante.",
   "start": 12.115,
   "end": 15.272
  },
  {
   "i": 5,
   "text": "En cada vaivén, el áncora deja pasar un solo diente.",
   "start": 15.522,
   "end": 18.615
  },
  {
   "i": 6,
   "text": "Así los engranajes y las agujas avanzan a pasos iguales.",
   "start": 18.865,
   "end": 22.236
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 22.486,
   "end": 25.153
  }
 ],
