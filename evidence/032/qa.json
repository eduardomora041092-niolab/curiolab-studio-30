 "segments": [
  {
   "i": 0,
   "text": "¿Cómo convierte un micrófono tu voz en electricidad?",
   "start": 0.0,
   "end": 2.859
  },
  {
   "i": 1,
   "text": "Tu voz hace vibrar el aire, que empuja una membrana.",
   "start": 3.109,
   "end": 5.925
  },
  {
   "i": 2,
   "text": "En uno dinámico, la membrana lleva una bobina junto a un imán.",
   "start": 6.175,
   "end": 9.545
  },
  {
   "i": 3,
   "text": "Al vibrar, la bobina se mueve dentro del campo magnético.",
   "start": 9.795,
   "end": 12.889
  },
  {
   "i": 4,
   "text": "Mover un cable en un campo magnético genera corriente.",
   "start": 13.139,
   "end": 16.317
  },
  {
   "i": 5,
   "text": "Esa corriente sube y baja al ritmo de tu voz.",
   "start": 16.567,
   "end": 19.213
  },
  {
   "i": 6,
   "text": "Es un altavoz funcionando al revés: sonido convertido en señal.",
   "start": 19.463,
   "end": 23.089
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 23.339,
   "end": 26.006
  }
 ],
