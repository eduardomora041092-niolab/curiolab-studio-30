 "segments": [
  {
   "i": 0,
   "text": "¿Cómo lanza una nube tan fina un pulverizador?",
   "start": 0.0,
   "end": 2.603
  },
  {
   "i": 1,
   "text": "Al apretar el gatillo, empujas un pistón dentro de un cilindro.",
   "start": 2.853,
   "end": 6.373
  },
  {
   "i": 2,
   "text": "El pistón presiona el líquido, que cierra una válvula y abre otra.",
   "start": 6.623,
   "end": 10.164
  },
  {
   "i": 3,
   "text": "El líquido sale a presión por un agujero diminuto de la boquilla.",
   "start": 10.414,
   "end": 13.87
  },
  {
   "i": 4,
   "text": "Allí se rompe en gotitas muy finas: una nube.",
   "start": 14.12,
   "end": 16.68
  },
  {
   "i": 5,
   "text": "Al soltar, un muelle devuelve el gatillo y el pistón.",
   "start": 16.93,
   "end": 19.725
  },
  {
   "i": 6,
   "text": "Eso aspira líquido de la botella por el tubo, listo para otro apretón.",
   "start": 19.975,
   "end": 23.772
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 24.022,
   "end": 26.689
  }
 ],
