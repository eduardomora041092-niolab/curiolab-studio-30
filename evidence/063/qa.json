 "segments": [
  {
   "i": 0,
   "text": "¿Por qué lloras al cortar una cebolla?",
   "start": 0.0,
   "end": 2.133
  },
  {
   "i": 1,
   "text": "La cebolla guarda sustancias y enzimas en compartimentos separados.",
   "start": 2.383,
   "end": 6.223
  },
  {
   "i": 2,
   "text": "Al cortarla, rompes sus células y se mezclan.",
   "start": 6.473,
   "end": 9.055
  },
  {
   "i": 3,
   "text": "La reacción produce un gas irritante que flota en el aire.",
   "start": 9.305,
   "end": 12.462
  },
  {
   "i": 4,
   "text": "Es una defensa química que ahuyenta a los animales.",
   "start": 12.712,
   "end": 15.613
  },
  {
   "i": 5,
   "text": "El gas llega a tus ojos y estimula sus nervios.",
   "start": 15.863,
   "end": 18.658
  },
  {
   "i": 6,
   "text": "Tus ojos responden con lágrimas para lavar el irritante.",
   "start": 18.908,
   "end": 22.001
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 22.251,
   "end": 24.918
  }
 ],
