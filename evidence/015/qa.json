 "segments": [
  {
   "i": 0,
   "text": "El hielo flota, aunque casi todo sólido se hunde.",
   "start": 0.0,
   "end": 2.709
  },
  {
   "i": 1,
   "text": "Las moléculas de agua se atraen mucho entre sí.",
   "start": 2.959,
   "end": 5.669
  },
  {
   "i": 2,
   "text": "En el líquido se mueven sin parar y se apretujan.",
   "start": 5.919,
   "end": 8.649
  },
  {
   "i": 3,
   "text": "Al congelarse, se enganchan en una red fija de hexágonos con huecos.",
   "start": 8.899,
   "end": 12.654
  },
  {
   "i": 4,
   "text": "Los huecos hacen que ocupe más espacio con la misma masa.",
   "start": 12.904,
   "end": 16.189
  },
  {
   "i": 5,
   "text": "Así es menos denso que el agua líquida, y por eso flota.",
   "start": 16.439,
   "end": 19.447
  },
  {
   "i": 6,
   "text": "Por eso los lagos se hielan por arriba, y debajo sigue la vida.",
   "start": 19.697,
   "end": 23.004
  },
  {
   "i": 7,
   "text": "Sígueme para más curiosidades de la ciencia.",
   "start": 23.254,
   "end": 25.601
  }
 ],
