 "segments": [
  {
   "i": 0,
   "text": "¿Por qué los copos de nieve tienen seis puntas?",
   "start": 0.0,
   "end": 2.56
  },
  {
   "i": 1,
   "text": "Un copo empieza como un cristal de hielo diminuto dentro de una nube.",
   "start": 2.81,
   "end": 6.565
  },
  {
   "i": 2,
   "text": "Al congelarse, las moléculas de agua se enlazan formando hexágonos.",
   "start": 6.815,
   "end": 10.74
  },
  {
   "i": 3,
   "text": "Esa red de seis lados da al cristal su forma hexagonal.",
   "start": 10.99,
   "end": 14.233
  },
  {
   "i": 4,
   "text": "El vapor de agua se pega más rápido en las seis esquinas.",
   "start": 14.483,
   "end": 17.597
  },
  {
   "i": 5,
   "text": "Así crecen seis brazos parecidos, porque todos viven el mismo aire.",
   "start": 17.847,
   "end": 21.773
  },
  {
   "i": 6,
   "text": "Cada copo sigue su propio camino, por eso casi nunca hay dos iguales.",
   "start": 22.023,
   "end": 26.055
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 26.305,
   "end": 28.971
  }
 ],
