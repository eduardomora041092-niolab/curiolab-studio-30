 "segments": [
  {
   "i": 0,
   "text": "¿Cómo cambia de marcha una bicicleta sin que se caiga la cadena?",
   "start": 0.0,
   "end": 3.371
  },
  {
   "i": 1,
   "text": "Detrás hay varios piñones de distintos tamaños, uno junto a otro.",
   "start": 3.621,
   "end": 7.29
  },
  {
   "i": 2,
   "text": "Al mover la palanca, un cable desplaza el cambio trasero.",
   "start": 7.54,
   "end": 10.761
  },
  {
   "i": 3,
   "text": "El cambio empuja la cadena hacia un lado, hasta otro piñón.",
   "start": 11.011,
   "end": 14.318
  },
  {
   "i": 4,
   "text": "Los dientes del piñón nuevo atrapan la cadena y la arrastran.",
   "start": 14.568,
   "end": 17.896
  },
  {
   "i": 5,
   "text": "Un muelle y dos ruedecillas mantienen la cadena siempre tensa.",
   "start": 18.146,
   "end": 21.687
  },
  {
   "i": 6,
   "text": "Piñón grande: pedaleas más fácil. Piñón pequeño: avanzas más por pedalada.",
   "start": 21.937,
   "end": 26.481
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 26.731,
   "end": 29.398
  }
 ],
