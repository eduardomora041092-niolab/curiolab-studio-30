 "segments": [
  {
   "i": 0,
   "text": "¿Cómo se forma una nube en el cielo?",
   "start": 0.0,
   "end": 1.963
  },
  {
   "i": 1,
   "text": "El sol calienta el suelo y el aire húmedo empieza a subir.",
   "start": 2.213,
   "end": 5.477
  },
  {
   "i": 2,
   "text": "Ese aire lleva vapor de agua, un gas invisible que no vemos.",
   "start": 5.727,
   "end": 9.097
  },
  {
   "i": 3,
   "text": "Al subir, la presión baja, el aire se expande y se enfría.",
   "start": 9.347,
   "end": 12.569
  },
  {
   "i": 4,
   "text": "El aire frío no puede guardar tanto vapor.",
   "start": 12.819,
   "end": 15.379
  },
  {
   "i": 5,
   "text": "El vapor se condensa en gotitas sobre motas de polvo y sal.",
   "start": 15.629,
   "end": 19.106
  },
  {
   "i": 6,
   "text": "Millones de gotitas juntas forman la nube blanca que vemos.",
   "start": 19.356,
   "end": 22.684
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 22.934,
   "end": 25.601
  }
 ],
