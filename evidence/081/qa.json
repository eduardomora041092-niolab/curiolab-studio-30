 "segments": [
  {
   "i": 0,
   "text": "¿Por qué tu voz vuelve cuando gritas frente a una montaña?",
   "start": 0.0,
   "end": 3.072
  },
  {
   "i": 1,
   "text": "El sonido es una onda que viaja por el aire.",
   "start": 3.322,
   "end": 5.903
  },
  {
   "i": 2,
   "text": "Cuando choca con una superficie grande y dura, rebota.",
   "start": 6.153,
   "end": 9.289
  },
  {
   "i": 3,
   "text": "La onda rebotada vuelve hacia ti, un poco más tarde.",
   "start": 9.539,
   "end": 12.526
  },
  {
   "i": 4,
   "text": "Si la pared está lejos, oyes la repetición separada: eso es el eco.",
   "start": 12.776,
   "end": 16.595
  },
  {
   "i": 5,
   "text": "Si está cerca, el rebote llega tan rápido que se mezcla con tu voz.",
   "start": 16.845,
   "end": 20.706
  },
  {
   "i": 6,
   "text": "Las superficies blandas, como las cortinas, absorben el sonido y casi no rebota.",
   "start": 20.956,
   "end": 25.521
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 25.771,
   "end": 28.438
  }
 ],
