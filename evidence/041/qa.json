 "segments": [
  {
   "i": 0,
   "text": "¿Cómo funciona una cafetera italiana?",
   "start": 0.0,
   "end": 2.24
  },
  {
   "i": 1,
   "text": "Tiene tres partes: depósito de agua, filtro con café y jarra.",
   "start": 2.49,
   "end": 5.861
  },
  {
   "i": 2,
   "text": "Al calentar el depósito, el agua empieza a evaporarse.",
   "start": 6.111,
   "end": 9.268
  },
  {
   "i": 3,
   "text": "El aire y el vapor atrapados arriba aumentan la presión.",
   "start": 9.518,
   "end": 12.739
  },
  {
   "i": 4,
   "text": "Esa presión empuja el agua hacia arriba por un embudo.",
   "start": 12.989,
   "end": 16.147
  },
  {
   "i": 5,
   "text": "El agua caliente atraviesa el café molido del filtro.",
   "start": 16.397,
   "end": 19.447
  },
  {
   "i": 6,
   "text": "Sale por la columna central y llena la jarra de café.",
   "start": 19.697,
   "end": 22.599
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 22.849,
   "end": 25.515
  }
 ],
