 "segments": [
  {
   "i": 0,
   "text": "¿Qué pasa dentro del piano al pulsar una tecla?",
   "start": 0.0,
   "end": 2.688
  },
  {
   "i": 1,
   "text": "Cada tecla es una palanca que gira sobre un punto.",
   "start": 2.938,
   "end": 5.925
  },
  {
   "i": 2,
   "text": "Al bajar la parte delantera, la trasera sube.",
   "start": 6.175,
   "end": 8.799
  },
  {
   "i": 3,
   "text": "Ese impulso lanza un martillo forrado de fieltro.",
   "start": 9.049,
   "end": 11.907
  },
  {
   "i": 4,
   "text": "El martillo golpea la cuerda y rebota al instante.",
   "start": 12.157,
   "end": 15.101
  },
  {
   "i": 5,
   "text": "A la vez se levanta el apagador y la cuerda vibra libre.",
   "start": 15.351,
   "end": 18.359
  },
  {
   "i": 6,
   "text": "Al soltar la tecla, el apagador baja y el sonido para.",
   "start": 18.609,
   "end": 21.788
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 22.038,
   "end": 24.705
  }
 ],
