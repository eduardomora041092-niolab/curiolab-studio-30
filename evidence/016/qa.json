 "segments": [
  {
   "i": 0,
   "text": "Un solo empujón abre todas las varillas del paraguas.",
   "start": 0.0,
   "end": 2.923
  },
  {
   "i": 1,
   "text": "Las varillas largas cuelgan de una corona en la punta.",
   "start": 3.173,
   "end": 6.031
  },
  {
   "i": 2,
   "text": "Más abajo, la corredera rodea el mástil y se desliza.",
   "start": 6.281,
   "end": 9.524
  },
  {
   "i": 3,
   "text": "Una varilla corta une cada varilla larga a la corredera.",
   "start": 9.774,
   "end": 12.803
  },
  {
   "i": 4,
   "text": "Al subir la corredera, las cortas empujan las largas hacia fuera.",
   "start": 13.053,
   "end": 16.787
  },
  {
   "i": 5,
   "text": "Todas se abren a la vez y estiran la tela.",
   "start": 17.037,
   "end": 19.319
  },
  {
   "i": 6,
   "text": "Un pestillo con muelle sujeta la corredera; al apretarlo, se cierra.",
   "start": 19.569,
   "end": 23.345
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 23.595,
   "end": 26.262
  }
 ],
