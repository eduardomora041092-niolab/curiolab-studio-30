 "segments": [
  {
   "i": 0,
   "text": "¿Cómo imprime una impresora de tinta?",
   "start": 0.0,
   "end": 2.005
  },
  {
   "i": 1,
   "text": "Un cabezal se desliza sobre el papel de un lado a otro.",
   "start": 2.255,
   "end": 5.221
  },
  {
   "i": 2,
   "text": "Por debajo tiene muchísimas boquillas diminutas llenas de tinta.",
   "start": 5.471,
   "end": 9.14
  },
  {
   "i": 3,
   "text": "En unas, una resistencia calienta la tinta y forma una burbuja.",
   "start": 9.39,
   "end": 12.995
  },
  {
   "i": 4,
   "text": "La burbuja empuja y dispara una gota más fina que un cabello.",
   "start": 13.245,
   "end": 16.552
  },
  {
   "i": 5,
   "text": "En otras, un cristal piezoeléctrico se dobla y expulsa la gota.",
   "start": 16.802,
   "end": 20.407
  },
  {
   "i": 6,
   "text": "Miles de puntos juntos forman letras, fotos y colores.",
   "start": 20.657,
   "end": 23.729
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 23.979,
   "end": 26.646
  }
 ],
