 "segments": [
  {
   "i": 0,
   "text": "¿Por qué gira el brazo del lavavajillas sin motor propio?",
   "start": 0.0,
   "end": 2.923
  },
  {
   "i": 1,
   "text": "Una bomba empuja agua dentro del brazo, que está hueco.",
   "start": 3.173,
   "end": 6.159
  },
  {
   "i": 2,
   "text": "El agua sale a presión por pequeños agujeros.",
   "start": 6.409,
   "end": 9.033
  },
  {
   "i": 3,
   "text": "En cada extremo, algunos agujeros apuntan hacia un lado.",
   "start": 9.283,
   "end": 12.633
  },
  {
   "i": 4,
   "text": "Al lanzar el agua hacia atrás, el brazo recibe un empujón hacia delante.",
   "start": 12.883,
   "end": 16.701
  },
  {
   "i": 5,
   "text": "Es acción y reacción, como un globo que se desinfla.",
   "start": 16.951,
   "end": 19.853
  },
  {
   "i": 6,
   "text": "Así gira y reparte el agua por toda la vajilla.",
   "start": 20.103,
   "end": 22.855
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 23.105,
   "end": 25.771
  }
 ],
