 "segments": [
  {
   "i": 0,
   "text": "¿Cómo produce luz un LED?",
   "start": 0.0,
   "end": 1.749
  },
  {
   "i": 1,
   "text": "Dentro hay un cristal semiconductor con dos zonas distintas.",
   "start": 1.999,
   "end": 5.37
  },
  {
   "i": 2,
   "text": "Una zona tiene electrones de sobra; la otra, huecos libres.",
   "start": 5.62,
   "end": 8.991
  },
  {
   "i": 3,
   "text": "Al conectar la pila, ambos se empujan hacia la unión.",
   "start": 9.241,
   "end": 12.099
  },
  {
   "i": 4,
   "text": "Cuando un electrón cae en un hueco, suelta energía.",
   "start": 12.349,
   "end": 14.995
  },
  {
   "i": 5,
   "text": "Esa energía sale como una partícula de luz: un fotón.",
   "start": 15.245,
   "end": 18.274
  },
  {
   "i": 6,
   "text": "No calienta ningún filamento, por eso desperdicia mucho menos calor.",
   "start": 18.524,
   "end": 22.449
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 22.699,
   "end": 25.366
  }
 ],
