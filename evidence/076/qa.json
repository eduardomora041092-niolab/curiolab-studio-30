 "segments": [
  {
   "i": 0,
   "text": "¿Cómo funciona el mando a distancia de la tele?",
   "start": 0.0,
   "end": 2.581
  },
  {
   "i": 1,
   "text": "En la punta del mando hay un LED que emite luz infrarroja.",
   "start": 2.831,
   "end": 6.074
  },
  {
   "i": 2,
   "text": "Esa luz es invisible para tus ojos, pero muchas cámaras de móvil sí la captan.",
   "start": 6.324,
   "end": 10.783
  },
  {
   "i": 3,
   "text": "Al pulsar un botón, el LED se enciende y se apaga muy rápido.",
   "start": 11.033,
   "end": 14.574
  },
  {
   "i": 4,
   "text": "Esos destellos forman un código distinto para cada botón.",
   "start": 14.824,
   "end": 18.109
  },
  {
   "i": 5,
   "text": "En la tele, un receptor detecta los pulsos y los convierte en señal eléctrica.",
   "start": 18.359,
   "end": 22.711
  },
  {
   "i": 6,
   "text": "Un chip lee el código y sube el volumen o cambia de canal.",
   "start": 22.961,
   "end": 26.161
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 26.411,
   "end": 29.078
  }
 ],
