 "segments": [
  {
   "i": 0,
   "text": "¿Cómo brillan las luciérnagas?",
   "start": 0.0,
   "end": 1.771
  },
  {
   "i": 1,
   "text": "Su luz no viene del fuego ni de la electricidad.",
   "start": 2.021,
   "end": 4.645
  },
  {
   "i": 2,
   "text": "Nace de una reacción química en la parte final de su abdomen.",
   "start": 4.895,
   "end": 8.223
  },
  {
   "i": 3,
   "text": "Allí, una molécula llamada luciferina reacciona con oxígeno.",
   "start": 8.473,
   "end": 11.993
  },
  {
   "i": 4,
   "text": "Una enzima, la luciferasa, acelera esa reacción.",
   "start": 12.243,
   "end": 15.229
  },
  {
   "i": 5,
   "text": "La energía sale sobre todo como luz y apenas da calor.",
   "start": 15.479,
   "end": 18.722
  },
  {
   "i": 6,
   "text": "Por eso se llama luz fría; la usan para encontrar pareja.",
   "start": 18.972,
   "end": 22.343
  },
  {
   "i": 7,
   "text": "Sígueme para más curiosidades de la ciencia.",
   "start": 22.593,
   "end": 24.939
  }
 ],
