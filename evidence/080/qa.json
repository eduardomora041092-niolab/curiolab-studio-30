 "segments": [
  {
   "i": 0,
   "text": "¿Por qué suben solas las alas del sacacorchos?",
   "start": 0.0,
   "end": 2.603
  },
  {
   "i": 1,
   "text": "Al girar la manija, la espiral se clava en el corcho.",
   "start": 2.853,
   "end": 5.797
  },
  {
   "i": 2,
   "text": "El eje central tiene dientes, como una cremallera.",
   "start": 6.047,
   "end": 8.628
  },
  {
   "i": 3,
   "text": "Esos dientes engranan con una rueda dentada en la base de cada ala.",
   "start": 8.878,
   "end": 12.675
  },
  {
   "i": 4,
   "text": "Mientras la espiral baja, el eje gira las ruedas y las alas suben.",
   "start": 12.925,
   "end": 16.552
  },
  {
   "i": 5,
   "text": "Luego bajas las alas y las ruedas empujan el eje hacia arriba.",
   "start": 16.802,
   "end": 20.279
  },
  {
   "i": 6,
   "text": "Las alas son palancas largas: con poca fuerza sacas el corcho.",
   "start": 20.529,
   "end": 24.284
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 24.534,
   "end": 27.201
  }
 ],
