 "segments": [
  {
   "i": 0,
   "text": "¿Por qué se empaña el espejo del baño?",
   "start": 0.0,
   "end": 2.112
  },
  {
   "i": 1,
   "text": "El agua caliente de la ducha se evapora y llena el aire de vapor.",
   "start": 2.362,
   "end": 5.797
  },
  {
   "i": 2,
   "text": "Ese vapor es un gas invisible, mezclado con el aire.",
   "start": 6.047,
   "end": 9.119
  },
  {
   "i": 3,
   "text": "El espejo está más frío que ese aire caliente y húmedo.",
   "start": 9.369,
   "end": 12.377
  },
  {
   "i": 4,
   "text": "Al tocarlo, el aire se enfría y el vapor se condensa.",
   "start": 12.627,
   "end": 15.763
  },
  {
   "i": 5,
   "text": "Se forman gotitas diminutas que desvían la luz en todas direcciones.",
   "start": 16.013,
   "end": 19.831
  },
  {
   "i": 6,
   "text": "Por eso ves una capa blanca y no tu reflejo.",
   "start": 20.081,
   "end": 22.855
  },
  {
   "i": 7,
   "text": "Sígueme para más curiosidades de la ciencia.",
   "start": 23.105,
   "end": 25.451
  }
 ],
