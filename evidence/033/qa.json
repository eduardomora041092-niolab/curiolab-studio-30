 "segments": [
  {
   "i": 0,
   "text": "¿Qué hace crecer la masa del pan?",
   "start": 0.0,
   "end": 2.027
  },
  {
   "i": 1,
   "text": "En la masa viven levaduras: hongos diminutos, de una sola célula.",
   "start": 2.277,
   "end": 5.861
  },
  {
   "i": 2,
   "text": "Se alimentan de los azúcares que vienen de la harina.",
   "start": 6.111,
   "end": 8.905
  },
  {
   "i": 3,
   "text": "Y, al comerlos, sueltan un gas: el dióxido de carbono.",
   "start": 9.155,
   "end": 12.078
  },
  {
   "i": 4,
   "text": "Al amasar, el gluten de la harina forma una red elástica.",
   "start": 12.328,
   "end": 15.549
  },
  {
   "i": 5,
   "text": "Esa red atrapa el gas en muchas burbujas que inflan la masa.",
   "start": 15.799,
   "end": 19.319
  },
  {
   "i": 6,
   "text": "En el horno, el gas se expande y el calor fija la miga.",
   "start": 19.569,
   "end": 22.428
  },
  {
   "i": 7,
   "text": "Sígueme para más curiosidades de la ciencia.",
   "start": 22.678,
   "end": 25.025
  }
 ],
