 "segments": [
  {
   "i": 0,
   "text": "¿Por qué de repente tiembla el suelo bajo tus pies?",
   "start": 0.0,
   "end": 2.688
  },
  {
   "i": 1,
   "text": "La corteza de la Tierra está dividida en grandes placas.",
   "start": 2.938,
   "end": 6.117
  },
  {
   "i": 2,
   "text": "Las placas se mueven muy despacio, unos centímetros al año.",
   "start": 6.367,
   "end": 9.695
  },
  {
   "i": 3,
   "text": "En las fallas, el roce las deja atascadas.",
   "start": 9.945,
   "end": 12.334
  },
  {
   "i": 4,
   "text": "La roca se deforma y acumula tensión, como un muelle.",
   "start": 12.584,
   "end": 15.592
  },
  {
   "i": 5,
   "text": "Cuando la tensión vence al roce, la falla se desliza de golpe.",
   "start": 15.842,
   "end": 19.341
  },
  {
   "i": 6,
   "text": "La energía sale en ondas sísmicas: eso es el terremoto.",
   "start": 19.591,
   "end": 22.812
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 23.062,
   "end": 25.729
  }
 ],
