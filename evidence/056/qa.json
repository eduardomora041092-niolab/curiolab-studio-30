 "segments": [
  {
   "i": 0,
   "text": "¿Por qué el aire entra en la rueda pero no sale?",
   "start": 0.0,
   "end": 2.432
  },
  {
   "i": 1,
   "text": "La válvula tiene dentro un tapón y un pequeño muelle.",
   "start": 2.682,
   "end": 5.541
  },
  {
   "i": 2,
   "text": "El muelle aprieta el tapón contra un asiento y la cierra.",
   "start": 5.791,
   "end": 8.735
  },
  {
   "i": 3,
   "text": "Además, el aire de la rueda empuja el tapón hacia fuera.",
   "start": 8.985,
   "end": 11.971
  },
  {
   "i": 4,
   "text": "Cuanta más presión hay dentro, más fuerte queda cerrada.",
   "start": 12.221,
   "end": 15.293
  },
  {
   "i": 5,
   "text": "Al inflar, el inflador empuja el tapón hacia dentro y el aire entra.",
   "start": 15.543,
   "end": 19.191
  },
  {
   "i": 6,
   "text": "Al retirarlo, el muelle y la presión la cierran otra vez.",
   "start": 19.441,
   "end": 22.556
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 22.806,
   "end": 25.473
  }
 ],
