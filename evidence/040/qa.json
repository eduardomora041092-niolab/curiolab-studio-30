 "segments": [
  {
   "i": 0,
   "text": "¿Por qué cocina más rápido una olla a presión?",
   "start": 0.0,
   "end": 2.56
  },
  {
   "i": 1,
   "text": "En una olla normal, el agua hierve a unos cien grados.",
   "start": 2.81,
   "end": 5.69
  },
  {
   "i": 2,
   "text": "El vapor escapa y la temperatura no sube más.",
   "start": 5.94,
   "end": 8.649
  },
  {
   "i": 3,
   "text": "La olla a presión cierra la tapa herméticamente.",
   "start": 8.899,
   "end": 11.694
  },
  {
   "i": 4,
   "text": "El vapor queda atrapado y la presión dentro aumenta.",
   "start": 11.944,
   "end": 14.931
  },
  {
   "i": 5,
   "text": "Con más presión, el agua hierve a más de cien grados.",
   "start": 15.181,
   "end": 18.061
  },
  {
   "i": 6,
   "text": "Más calor cocina antes; una válvula libera el vapor sobrante.",
   "start": 18.311,
   "end": 21.937
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 22.187,
   "end": 24.854
  }
 ],
