 "segments": [
  {
   "i": 0,
   "text": "¿Cómo controla una sola palanca el chorro y la temperatura?",
   "start": 0.0,
   "end": 3.093
  },
  {
   "i": 1,
   "text": "Dentro del grifo hay un cartucho con dos discos de cerámica.",
   "start": 3.343,
   "end": 6.629
  },
  {
   "i": 2,
   "text": "El disco de abajo está fijo, con una entrada fría y otra caliente.",
   "start": 6.879,
   "end": 10.548
  },
  {
   "i": 3,
   "text": "El de arriba se mueve con la palanca y tiene una abertura.",
   "start": 10.798,
   "end": 13.87
  },
  {
   "i": 4,
   "text": "Al subir la palanca, la abertura destapa más agujero y sale más agua.",
   "start": 14.12,
   "end": 18.152
  },
  {
   "i": 5,
   "text": "Al girarla, destapa más el caliente o el frío y cambia la mezcla.",
   "start": 18.402,
   "end": 22.071
  },
  {
   "i": 6,
   "text": "Los discos son tan lisos que, al cerrar, no dejan pasar el agua.",
   "start": 22.321,
   "end": 25.713
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir cómo funcionan más cosas.",
   "start": 25.963,
   "end": 28.63
  }
 ],
