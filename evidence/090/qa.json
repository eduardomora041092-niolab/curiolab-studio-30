 "segments": [
  {
   "i": 0,
   "text": "¿Cómo trepa un gecko por un cristal liso sin resbalar?",
   "start": 0.0,
   "end": 2.901
  },
  {
   "i": 1,
   "text": "No usa ventosas ni pegamento: sus dedos están secos.",
   "start": 3.151,
   "end": 6.309
  },
  {
   "i": 2,
   "text": "Bajo cada dedo hay muchísimos pelos microscópicos.",
   "start": 6.559,
   "end": 9.609
  },
  {
   "i": 3,
   "text": "Cada pelo se divide en puntas todavía más finas.",
   "start": 9.859,
   "end": 12.633
  },
  {
   "i": 4,
   "text": "Esas puntas se acercan tanto al cristal que sus moléculas se atraen.",
   "start": 12.883,
   "end": 16.723
  },
  {
   "i": 5,
   "text": "Cada atracción es diminuta, pero sumadas todas sostienen al gecko entero.",
   "start": 16.973,
   "end": 21.133
  },
  {
   "i": 6,
   "text": "Para soltarse, levanta el dedo desde la punta y se despega fácilmente.",
   "start": 21.383,
   "end": 25.457
  },
  {
   "i": 7,
   "text": "Sígueme para descubrir más ciencia.",
   "start": 25.707,
   "end": 27.67
  }
 ],
